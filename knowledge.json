    "cal_prev": {"en": "Your previous {label} was \"{title}\" ({type}).", "ne": "तपाईंको अघिल्लो {label} \"{title}\" ({type}) थियो।", "rn": "Tapaiko aghillo {label} \"{title}\" ({type}) thiyo."},
    "cal_now": {"en": "\"{title}\" is going on right now (until {end}).", "ne": "\"{title}\" अहिले चलिरहेको छ ({end} सम्म)।", "rn": "\"{title}\" ahile chaliraheko cha ({end} samma)."},
    "cal_now_none": {"en": "No {label} is going on right now.", "ne": "अहिले कुनै {label} चलिरहेको छैन।", "rn": "Ahile kunai {label} chaliraheko chaina."},
    "cal_none": {"en": "I couldn't find any {label} in the calendar for that. I don't want to guess, so please check with your school.", "ne": "पात्रोमा {label} फेला परेन। म अनुमान गर्दिनँ, कृपया विद्यालयसँग सोध्नुहोस्।", "rn": "Patro ma {label} fela paren. Ma anuman gardina, kripaya school sanga sodhnuhos."},
