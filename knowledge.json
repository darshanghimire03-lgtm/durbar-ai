  "messages": {
    "fallback": {"en": "I don't know that yet. You can teach me!", "ne": "मलाई यो अहिलेसम्म थाहा छैन। तपाईंले मलाई सिकाउन सक्नुहुन्छ!", "rn": "Malai yo ahilesamma thaha chaina. Tapaile malai sikauna saknuhuncha!"},
    "empty": {"en": "Please type a message.", "ne": "कृपया सन्देश लेख्नुहोस्।", "rn": "Kripaya message lekhnuhos."},
    "db_unavailable": {"en": "I can't reach my information database right now. Please try again in a little while.", "ne": "म अहिले मेरो जानकारी डाटाबेसमा पुग्न सक्दिनँ। कृपया केही समयपछि फेरि प्रयास गर्नुहोस्।", "rn": "Ma ahile mero jankari database ma pugna sakdina. Kripaya kehi samaya pachi pheri prayas garnuhos."},
    "error": {"en": "Sorry, something went wrong while answering. Please try again.", "ne": "माफ गर्नुहोस्, जवाफ दिँदा केही गडबड भयो। कृपया फेरि प्रयास गर्नुहोस्।", "rn": "Maaf garnuhos, jawaf dida kehi gadbad bhayo. Kripaya pheri prayas garnuhos."},
    "rate_limited": {"en": "You're asking very quickly! Please wait a minute and try again.", "ne": "तपाईंले धेरै छिटो-छिटो सोध्दै हुनुहुन्छ! कृपया एक मिनेट पर्खेर फेरि प्रयास गर्नुहोस्।", "rn": "Tapaile dherai chito-chito sodhdai hunuhuncha! Kripaya euta minute parkhera pheri prayas garnuhos."},
    "date_unavailable": {"en": "I couldn't work out today's Bikram Sambat date, so I can't check the calendar right now.", "ne": "आजको विक्रम सम्वत् मिति निकाल्न सकिनँ, त्यसैले अहिले पात्रो हेर्न सक्दिनँ।", "rn": "Aajako Bikram Sambat miti nikalna sakina, tesaile ahile patro herna sakdina."},
    "ask_subject": {"en": "Which subject or chapter do you need notes for? For example: \"computer note\" or \"English notes\".", "ne": "तपाईंलाई कुन विषय वा अध्यायको नोट चाहियो? जस्तै: \"कम्प्युटर नोट\" वा \"अंग्रेजी नोट\"।", "rn": "Tapailai kun subject ya adhyayako note chahiyo? Jastai: \"computer ko note\" ya \"English ko note\"."},
